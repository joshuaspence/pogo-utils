{
  "name": "pogo-utils",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rm -rf dist .types && tsc -b --force tsconfig.json scripts/tsconfig.json && node scripts/bundle.mts && node scripts/assemble.mts",
    "build:ics": "node scripts/build-ics.mts",
    "lint": "npm-run-all --continue-on-error --parallel --print-label lint:css lint:html lint:js lint:prettier lint:types lint:xml",
    "lint:css": "stylelint '**/*.css'",
    "lint:css:fix": "stylelint --fix '**/*.css'",
    "lint:fix": "npm-run-all --print-label --serial lint:xml:fix lint:css:fix lint:js:fix lint:prettier:fix",
    "lint:html": "html-validate '**/*.html'",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint --fix .",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:types": "pnpm build",
    "lint:xml": "node scripts/validate-gpx.mts",
    "lint:xml:fix": "node scripts/validate-gpx.mts --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.0",
    "@types/tz-lookup": "^6.1.2",
    "@xmldom/xmldom": "^0.9.11",
    "esbuild": "^0.28.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.11.0",
    "html-validate": "11.7.0",
    "leaflet": "^1.9.4",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "tz-lookup": "^6.1.25",
    "xmllint-wasm": "5.3.0"
  },
  "packageManager": "pnpm@11.22.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
