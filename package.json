{
  "name": "pogo-utils",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm-run-all --print-label --serial build:clean build:types build:data build:bundle build:ics build:icons build:assemble",
    "build:assemble": "node scripts/assemble.mts",
    "build:bundle": "node scripts/bundle.mts",
    "build:clean": "rm -rf dist",
    "build:data": "node scripts/validate-gpx.mts --write",
    "build:icons": "node scripts/build-icons.mts",
    "build:ics": "node scripts/build-ics.mts",
    "build:types": "tsc -b tsconfig.json scripts/tsconfig.json",
    "check:served-types": "node scripts/check-served-types.mts",
    "clean": "rm -rf dist .types",
    "inventory": "node scripts/inventory.mts",
    "lint": "npm-run-all --continue-on-error --parallel --print-label 'lint:!(fix)'",
    "lint:css": "stylelint '**/*.css'",
    "lint:css:fix": "stylelint --fix '**/*.css'",
    "lint:fix": "npm-run-all --print-label --serial lint:css:fix lint:js:fix lint:prettier:fix",
    "lint:html": "html-validate '**/*.html'",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint --fix .",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:types": "pnpm build",
    "lint:xml": "node scripts/validate-gpx.mts",
    "prune:events": "node scripts/prune-events.mts",
    "serve": "node scripts/serve.mts",
    "test": "vitest run",
    "test:corpus": "vitest run --project corpus",
    "test:coverage": "vitest run --coverage",
    "test:default": "vitest run --project default",
    "vend": "npm-run-all --continue-on-error --parallel --print-label 'vend:*'",
    "vend:events": "node scripts/vend-feed.mts",
    "vend:game-master": "node scripts/vend-game-master.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/tz-lookup": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.13.0",
    "html-validate": "11.16.2",
    "leaflet": "^1.9.4",
    "npm-run-all2": "^9.0.3",
    "preact": "^11.0.0",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "tz-lookup": "^6.1.25",
    "vitest": "5.0.3",
    "xmllint-wasm": "5.3.0"
  },
  "packageManager": "pnpm@11.22.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
