{
  "name": "pogo-utils",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "npm-run-all --continue-on-error --parallel --print-label lint:css lint:html lint:js lint:prettier lint:xml",
    "lint:css": "stylelint '**/*.css'",
    "lint:css:fix": "stylelint --fix '**/*.css'",
    "lint:fix": "npm-run-all --print-label --serial lint:xml:fix lint:css:fix lint:js:fix lint:prettier:fix",
    "lint:html": "html-validate '**/*.html'",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint --fix .",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:xml": "node scripts/validate-gpx.mjs",
    "lint:xml:fix": "node scripts/validate-gpx.mjs --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@xmldom/xmldom": "^0.9.11",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.11.0",
    "html-validate": "11.7.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "xmllint-wasm": "5.3.0"
  },
  "packageManager": "pnpm@11.22.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.0.0",
      "onFail": "download"
    }
  }
}
