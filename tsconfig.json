// The browser half. Pages serves the compiler's output rather than these files, so this is where the build lives.
{
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "target": "ES2023",

    // `nodenext` rather than `bundler` because it is the only setting that makes a missing extension an *error*. A
    // browser resolves `./dom.js` and nothing else, where `bundler` accepts `./dom` and emits it verbatim — a module
    // that type-checks and 404s. Node's algorithm is the one the browser is actually implementing here.
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "allowJs": true,
    "checkJs": true,

    // The pages load `src/…` and resolve it against their own URL, so the output has to keep the tree shape the markup
    // already names. `scripts/assemble.mts` copies the stylesheets in beside it.
    "outDir": "dist/src",
    "rootDir": "src",

    // `composite` forces declarations, which nothing serves — out of the published tree rather than into it.
    "declarationDir": ".types",

    // Named rather than left to default, because the default is derived from `outDir` and lands the cache *inside*
    // `dist/` — `dist/tsconfig.tsbuildinfo`, deployed to the live site. The allowlist cannot catch that, since it
    // governs what is copied in and this is written before it runs.
    "tsBuildInfoFile": ".types/tsconfig.tsbuildinfo",

    // `tsc -b` in `lint:types` builds both projects from one command, and build mode requires this of each of them.
    "composite": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,

    // Only Leaflet, so that installing any other @types package cannot silently hand Node's globals to a browser
    // module. Naming it is also what pulls it in at all, since an empty list would leave `L` undeclared.
    "types": ["leaflet"],

    // `L` arrives from a CDN <script> in map.html, and @types/leaflet declares it with `export as namespace L` — a UMD
    // global, which a module cannot otherwise see. Declaring it by hand instead does not work: a `declare global` for
    // `L` shadows that namespace, which breaks the package's own internal references to it.
    "allowUmdGlobalAccess": true
  },
  "include": ["src/**/*.js", "src/types.d.ts"]
}
