// The browser half. Pages serves the compiler's output rather than these files, so this is where the build lives.
{
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "target": "ES2023",

    // `nodenext` rather than `bundler` because it is the only setting that makes a missing extension an *error*. A
    // browser resolves `./dom.js` and nothing else, where `bundler` accepts `./dom` and emits it verbatim — a module
    // that type-checks and 404s. Node's algorithm is the one the browser is actually implementing here.
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // `scripts/bundle.mts` writes the JavaScript, one file per page rather than one per module, so there is nothing for
    // the compiler to emit into `dist/` and no `outDir` here at all. Checking is still this project's job; the bundler
    // does no type analysis whatever.
    "emitDeclarationOnly": true,

    // `composite` forces declarations, which nothing serves — out of the published tree rather than into it. `rootDir`
    // is what `.types/` mirrors now that nothing else is emitted, named rather than inferred so that a file added
    // outside `src/` cannot quietly move every declaration a level down.
    "declarationDir": ".types",
    "rootDir": "src",

    // Beside the declarations, so that one `rm -rf .types` clears everything this project writes. The default is
    // derived from `outDir` when there is one, which put the cache at `dist/tsconfig.tsbuildinfo` and deployed it to
    // the live site — the allowlist in `scripts/assemble.mts` cannot catch that, since it governs what is copied in and
    // this is written before it runs.
    "tsBuildInfoFile": ".types/tsconfig.tsbuildinfo",

    // `tsc -b` in `lint:types` builds both projects from one command, and build mode requires this of each of them.
    "composite": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,

    // Only Leaflet, so that installing any other @types package cannot silently hand Node's globals to a browser
    // module. Naming it is also what pulls it in at all, since an empty list would leave `L` undeclared.
    "types": ["leaflet"],

    // `L` arrives from a CDN <script> in map.html, and @types/leaflet declares it with `export as namespace L` — a UMD
    // global, which a module cannot otherwise see. Declaring it by hand instead does not work: a `declare global` for
    // `L` shadows that namespace, which breaks the package's own internal references to it.
    "allowUmdGlobalAccess": true,

    // Pages serves what this emits, and a browser has no loader to erase anything for it, so a construct needing one is
    // not available here at all — the same rejection `scripts/` takes for Node's type stripping, for a different
    // reason.
    "erasableSyntaxOnly": true
  },

  // Everything in `src/` except what the shared project owns, reached through its declarations instead. Excluding those
  // by name rather than by directory because they sit among the files that import them: they are shared by what reads
  // them, not by where they live.
  "include": ["src/**/*.ts"],
  "exclude": ["src/countries.ts", "src/generated.ts", "src/recurring-types.ts", "src/types.d.ts"],

  "references": [{ "path": "tsconfig.shared.json" }]
}
