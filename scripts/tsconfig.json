// The Node half. These files never reach a browser, so they are real TypeScript, stripped by Node at run time rather
// than compiled — which is why nothing here emits either.
{
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",

    "noEmit": true,

    // `tsc -b` in `lint:types` builds both projects from one command, and build mode requires this of each of them.
    "composite": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,

    // Node strips the types and runs what is left, so anything it cannot erase in place — an `enum`, a `namespace`, a
    // parameter property — would compile here and fail at run time. This rejects all three at check time instead.
    "erasableSyntaxOnly": true,

    // Node's globals, deliberately absent from the browser project next door.
    "types": ["node"],

    // A value import from `src/` has to name the `.ts` file, because Node runs these by stripping types in place and
    // resolves the specifier literally — where `tsc` would have resolved `'../src/generated.js'` onto its `.ts` sibling
    // and said nothing, which is a check passing over an `ERR_MODULE_NOT_FOUND`. Permitted here because nothing in this
    // project emits, so no specifier has to survive into an output file. A *type* import is exempt and stays `.js`,
    // since it is erased before Node sees it — and `src/types.d.ts` could not be named any other way.
    "allowImportingTsExtensions": true
  },
  // The entry points here, and the inventory library they drive, which lives under `src/` with the rest of the source
  // and is claimed by this project rather than the browser one next door: it reaches `node:child_process` for `adb` and
  // the Tesseract CLI, so it needs Node's lib and must not have the DOM's. Nothing holds it here but this line — the
  // browser project's `src/**/*.ts` does not match an `.mts` file, so a module added there under a `.ts` name would be
  // checked against the wrong lib set instead of against none. The glob is the whole of `src/tools/`, so nothing the
  // suite runs from there goes unchecked.
  "include": ["*.mts", "../src/tools/**/*.mts"],

  // These scripts import the files `tsconfig.shared.json` lists — `src/countries.ts`, `src/event-feed.ts`,
  // `src/generated.ts`, `src/gpx-dialect.ts`, `src/recurring-types.ts` and `src/types.d.ts`. Build mode wants every
  // file a project reads listed by the project that reads it, and this used to mean naming each of them in the
  // `include` above and checking them a second time under this lib set. A reference is what it wanted all along: the
  // shared project emits declarations now, so this one reads those rather than the sources — and the files stay
  // environment-agnostic because that project says so, rather than because two lib sets happen to agree about them.

  "references": [{ "path": "../tsconfig.shared.json" }]
}
